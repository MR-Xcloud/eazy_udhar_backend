# Copy to /opt/eazyudhar/.env on VPS and fill in real values.
# Load before gunicorn: set -a && source /opt/eazyudhar/.env && set +a

# ── Django core ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
ALLOWED_HOSTS=api.yourdomain.com,your.vps.ip.address,localhost,127.0.0.1
BEHIND_HTTPS_PROXY=true

# Public base URL (SMS links, statement URLs, Razorpay webhooks)
PUBLIC_STATEMENT_BASE_URL=https://api.yourdomain.com
# Short link host in SMS body (no https) — use your public API domain, NOT server IP:8099
PUBLIC_STATEMENT_SMS_HOST=api.yourdomain.com

# CORS — comma-separated admin panel + web frontends (mobile apps ignore CORS)
CORS_ALLOWED_ORIGINS=https://admin.yourdomain.com,http://localhost:8080
CSRF_TRUSTED_ORIGINS=https://admin.yourdomain.com,https://api.yourdomain.com

# ── Database (recommended on VPS) ────────────────────────────────────────────
DB_ENGINE=mysql
DB_NAME=eazyudhar
DB_USER=eazyudhar
DB_PASSWORD=strong-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# ── Firebase push (FCM) ──────────────────────────────────────────────────────
# Place service-account JSON at: easyudhar/firebase/*-firebase-adminsdk*.json
# Or set explicit path:
# FIREBASE_PROJECT_ID=eazyudhar
# FIREBASE_CREDENTIALS_PATH=/opt/eazyudhar/easyudhar/firebase/eazyudhar-firebase-adminsdk-xxxxx.json

# ── Nimbus SMS ───────────────────────────────────────────────────────────────
NIMBUS_SMS_ENABLED=true
NIMBUS_USER_ID=EAZYUDHAR
NIMBUS_PASSWORD=your-nimbus-password
NIMBUS_AUTH_KEY=your-nimbus-auth-key
NIMBUS_DLT_ENTITY_ID=1201177925490858797
NIMBUS_SENDER_ID=EAZYUD
NIMBUS_SMS_PLATFORM_NAME=EAZYUDHAR

# ── Email OTP (Postmark) ─────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=your-postmark-server-token
OTP_FROM_EMAIL=alerts@yourdomain.com

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_MODE=live
RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxx
RAZORPAY_LIVE_KEY_SECRET=your-live-secret
RAZORPAY_LIVE_WEBHOOK_SECRET=your-webhook-secret
# Set false until Route is enabled on Razorpay dashboard
RAZORPAY_ROUTE_ENABLED=false

# ── WhatsApp (optional) ──────────────────────────────────────────────────────
WHATSAPP_API_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
