# Copy to .env in project root (easyudhar/.env)
# Local dev: DB_ENGINE=sqlite  |  Production VPS: DB_ENGINE=mysql

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token_urlsafe-50
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,10.244.55.190,192.168.0.147
BEHIND_HTTPS_PROXY=false
TIME_ZONE=Asia/Kolkata

# ── Database ─────────────────────────────────────────────────────────────────
# Local: sqlite (default). Production: mysql
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3
DB_NAME=eazyudhar
DB_USER=eazyudhar
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ── URLs (production: https://api.eazyudhar.com) ─────────────────────────────
PUBLIC_STATEMENT_BASE_URL=http://127.0.0.1:8099
# SMS short links — production must be public domain only (e.g. api.eazyudhar.com)
PUBLIC_STATEMENT_SMS_HOST=127.0.0.1:8099
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# ── Firebase FCM ─────────────────────────────────────────────────────────────
# Auto-detects easyudhar/firebase/*-firebase-adminsdk*.json if present
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_USE_ADC=

# ── Nimbus SMS ───────────────────────────────────────────────────────────────
NIMBUS_SMS_ENABLED=true
NIMBUS_USER_ID=EAZYUDHAR
NIMBUS_PASSWORD=
NIMBUS_AUTH_KEY=
NIMBUS_DLT_ENTITY_ID=1201177925490858797
NIMBUS_SENDER_ID=EAZYUD
NIMBUS_API_URL=http://nimbusit.net/api/pushsms
NIMBUS_CREDIT_TEMPLATE_ID=1207178013086303958
NIMBUS_PAYMENT_TEMPLATE_ID=1207178013900576203
NIMBUS_REMINDER_TEMPLATE_ID=1207178115256472122
NIMBUS_OTP_TEMPLATE_ID=
NIMBUS_OTP_SMS_TEXT=Your OTP for login to EAZYUDHAR is {#var#}. Valid for 5 minutes. Do not share. - EAZYUDHAR by INWIZY
NIMBUS_CREDIT_SMS_TEXT=Credit of Rs. {#var#} added to your account by {#var#} Check Balance and Details on {#var#} - EAZYUDHAR by INWIZY
NIMBUS_PAYMENT_SMS_TEXT=Payment of Rs. {#var#} credited to your account by {#var#} Check Balance and Details on {#var#} - EAZYUDHAR by INWIZY
NIMBUS_REMINDER_SMS_TEXT=Payment Reminder: Balance of Rs. {#var#} is pending with {#var#} . View details on: {#var#} - EAZYUDHAR by INWIZY
NIMBUS_SUMMARY_TEMPLATE_ID=
NIMBUS_SMS_PLATFORM_NAME=EAZYUDHAR
NIMBUS_SMS_VAR_MAX_LENGTH=30
NIMBUS_SMS_LINK_VAR_MAX_LENGTH=0
NIMBUS_MOBILE_PREFIX=
NIMBUS_SMS_CATEGORY=
NIMBUS_SMS_SUB_CATEGORY=
NIMBUS_SMS_EXTRA_PARAMS=
NIMBUS_REQUEST_TIMEOUT=30
# Keep false in production — waiting 3s per SMS blocks API responses.
NIMBUS_WAIT_DELIVERY_REPORT=false

# Chat / bill images — resize + JPEG compress before saving to media/
IMAGE_UPLOAD_MAX_DIMENSION=1024
IMAGE_UPLOAD_JPEG_QUALITY=75
IMAGE_UPLOAD_MIN_JPEG_QUALITY=35
IMAGE_UPLOAD_MIN_DIMENSION=480
IMAGE_UPLOAD_MAX_BYTES=65536

# ── Email OTP (Postmark) ─────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
OTP_FROM_EMAIL=alerts@inwizy.com
OTP_EMAIL_SUBJECT=Your EAZYUDHAR login code
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_EMAIL_LOGO_URL=https://res.cloudinary.com/dm2pfuzxn/image/upload/v1780986731/EazyUdhar_logo_jg0ybi.png

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=
RAZORPAY_ROUTE_ENABLED=false

# ── Telegram support bot ─────────────────────────────────────────────────────
# Bot token stays server-side only. Username powers the in-app "Chat on Telegram" link.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SUPPORT_EMAIL=support@eazyudhar.com

# ── WhatsApp (optional) ──────────────────────────────────────────────────────
WHATSAPP_API_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
